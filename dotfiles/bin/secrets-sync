#!/usr/bin/env zsh
# Proton Pass → Secret Service: copies every login item of the vault "env-secrets" into the Secret Service
# (gnome-keyring), where ~/.config/zsh/secrets.zsh reads them at shell start. Item title = env var name,
# password field = value. Items removed from the vault are removed from Secret Service too.
# Runs every 15 min from secrets-sync.timer (systemd --user); run by hand for an immediate sync.
# Values travel only through pipes, never through argv or stdout.
set -eu
setopt extendedglob pipefail

VAULT=env-secrets
SERVICE=env-secrets

pass-cli info >/dev/null 2>&1 || { print -u2 "pass-cli is not logged in: run pass-cli login"; exit 1; }

# One network call for the whole vault: "TITLE<TAB>base64(password)" per item
rows=("${(@f)$(pass-cli item list "$VAULT" --output json --show-secrets 2>/dev/null \
    | jq -r '.items[] | select(.state == "Active") | .content as $c | select($c.content.Login.password)
             | [$c.title, ($c.content.Login.password | @base64)] | @tsv')}")
rows=(${(M)rows:#[A-Z_][A-Z0-9_]#$'\t'*})   # only items titled as valid env var names
(( ${#rows} )) || { print -u2 "vault $VAULT has no usable items"; exit 1; }

names=()
for row in $rows; do
    n=${row%%$'\t'*}
    names+=$n
    print -rn -- "${row#*$'\t'}" | base64 -d | secret-tool store --label="$n" service "$SERVICE" key "$n"
done
unset rows row

# Drop entries whose item no longer exists in the vault
stored=("${(@f)$(secret-tool search --all service "$SERVICE" 2>/dev/null | sed -n 's/^label = //p')}")
stale=(${${stored:|names}:#})
for n in $stale; do secret-tool clear service "$SERVICE" key "$n"; done

print "synced ${#names} secrets from Proton Pass vault $VAULT to Secret Service, removed ${#stale} stale"
