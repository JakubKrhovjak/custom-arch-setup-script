[Unit]
Description=Port forward 127.0.0.1:15433 to dev1 design-time Postgres (dawspcirepo) via the @VM_NAME@ VM
# Started on demand (systemctl --user start), not at login
After=network-online.target

[Service]
ExecStart=/usr/bin/ssh -N -L 127.0.0.1:15433:dawspcirepo.hhcz.dev.acp.cz.tmo:5432 -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 @VM_USER@@@VM_IP@
Restart=always
RestartSec=10
